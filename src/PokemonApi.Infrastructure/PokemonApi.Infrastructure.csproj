<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Capa de infraestructura: implementaciones concretas de las abstracciones
    de aplicacion (carga del dataset incrustado y repositorios en memoria).
    Es la unica capa que conoce tecnologias externas.
  -->

  <PropertyGroup>
    <RootNamespace>PokemonApi.Infrastructure</RootNamespace>
    <AssemblyName>PokemonApi.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PokemonApi.Application\PokemonApi.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      El dataset se incrusta en el ensamblado: la API arranca sin archivos
      externos y sin red, y `dotnet publish` produce un artefacto autocontenido.
    -->
    <EmbeddedResource Include="Data\pokemon.json" LogicalName="PokemonApi.Infrastructure.Data.pokemon.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PokemonApi.IntegrationTests" />
  </ItemGroup>

</Project>
